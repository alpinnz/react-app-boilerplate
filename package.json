{
  "name": "react-app-boilerplate",
  "description": "Modular React application boilerplate with TypeScript, React Router, and Zustand.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc -b && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "test": "vitest run",
    "assets:generate": "valfuse-assets",
    "assets:check": "valfuse-assets --check",
    "i18n:generate": "valfuse-localization generate",
    "i18n:validate": "valfuse-localization validate",
    "docs:api": "typedoc",
    "preview": "vite preview --port 8080"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@valfuse-node/react": "^0.4.0",
    "country-flag-icons": "^1.6.20",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@valfuse-node/assets": "^0.2.0",
    "@valfuse-node/localization": "^0.5.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
